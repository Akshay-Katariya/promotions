# Groq LLM API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Salesforce Commerce Cloud (SFCC) DWSSO Basic Auth
# Put either the raw base64 string or 'Basic <base64>'
SFCC_BASIC_AUTH=Basic your_base64_encoded_client_id_and_secret_here

# SFCC Tenant & Site Configuration
SFCC_SHORT_CODE=your_short_code_here
SFCC_ORG_ID=f_ecom_your_org_id_here
SFCC_SITE_ID=your_site_id_here

# SFCC Endpoints (Optional overrides)
SFCC_TOKEN_URL=https://account.demandware.com/dwsso/oauth2/access_token
# SFCC_BASE_URL=https://your_short_code_here.api.commercecloud.salesforce.com/pricing/promotions/v1/organizations/f_ecom_your_org_id_here

